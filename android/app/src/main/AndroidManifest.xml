<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <permission
      android:name="com.colonelpanic.mova.permission.READ_TODOS"
      android:protectionLevel="dangerous"
      android:label="@string/permission_read_todos_label"
      android:description="@string/permission_read_todos_description"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:fullBackupContent="@xml/full_backup_content" android:dataExtractionRules="@xml/data_extraction_rules" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <service android:name="com.reactnativeandroidwidget.RNWidgetCollectionService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
    <service
        android:name=".QuickCaptureTileService"
        android:exported="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:label="@string/shortcut_capture_long"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE"/>
      </intent-filter>
    </service>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="mova"/>
      </intent-filter>
      <intent-filter data-generated="true">
        <action android:name="android.intent.action.VIEW"/>
        <data android:scheme="mova"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
    </activity>
    <activity android:name=".WidgetConfigurationActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
      </intent-filter>
    </activity>
    <activity
        android:name=".QuickCaptureActivity"
        android:exported="true"
        android:theme="@style/Theme.QuickCapture"
        android:excludeFromRecents="true"
        android:launchMode="singleInstance"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="mova" android:host="capture"/>
      </intent-filter>
    </activity>
    <activity
        android:name=".VoiceQuickCaptureActivity"
        android:exported="true"
        android:theme="@style/Theme.VoiceCapture"
        android:excludeFromRecents="true"
        android:launchMode="singleInstance"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="mova" android:host="capture-voice"/>
      </intent-filter>
    </activity>
    <activity
        android:name=".intents.IntentActivity"
        android:exported="true"
        android:theme="@style/Theme.Intent"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="mova"/>
        <data android:host="create"/>
        <data android:host="complete"/>
        <data android:host="update"/>
        <data android:host="reschedule"/>
        <data android:host="delete"/>
        <data android:host="refresh"/>
      </intent-filter>
    </activity>
    <service
        android:name=".eva.EvaExtensionService"
        android:exported="true">
      <intent-filter>
        <action android:name="com.colonelpanic.eva.action.EXTENSION"/>
      </intent-filter>
      <meta-data android:name="com.colonelpanic.eva.extension.version" android:value="1"/>
    </service>
    <provider
        android:name=".intents.TodoProvider"
        android:authorities="com.colonelpanic.mova.provider"
        android:exported="true"
        android:permission="com.colonelpanic.mova.permission.READ_TODOS"/>
    <activity-alias
        android:name=".QuickCaptureLauncherActivity"
        android:targetActivity=".QuickCaptureActivity"
        android:exported="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:label="@string/quick_capture_launcher_label">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <receiver android:name=".pins.PinActionReceiver" android:exported="false"/>
    <receiver android:name=".pins.PinBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
      </intent-filter>
    </receiver>
    <service android:name=".pins.PinWearListenerService" android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
        <data android:scheme="wear" android:host="*" android:pathPrefix="/mova/pin"/>
      </intent-filter>
    </service>
    <receiver android:name=".widget.QuickCaptureWidget" android:exported="true" android:label="Mova Quick Capture">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.colonelpanic.mova.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_quickcapturewidget"/>
    </receiver>
    <receiver android:name=".widget.AgendaWidget" android:exported="true" android:label="Mova Agenda">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.colonelpanic.mova.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_agendawidget"/>
    </receiver>
  </application>
</manifest>
